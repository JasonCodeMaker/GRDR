# Python
__pycache__/
*.py[cod]
*$py.class
*.so

# Local tools and scratch
.claude/
.test_artifacts/
.worktrees/
/test/
/tests/

# Data, caches, and external assets
/dataset/*
!/dataset/.gitkeep
/cache/*
!/cache/.gitkeep
/data/*/none/
/reranker/xpool/video_features_cache
/reranker/xpool/ckpt/*
!/reranker/xpool/ckpt/.gitkeep

# Runtime outputs
/figures/
/graphify-out/
/index/
/logs/
/output
/var
/wandb/

# Generated candidates
/candidates/baseline/
/candidates/*_ann_*_candidates_t*.json

# Research packages are opt-in so abandoned directions stay local.
/research/*
/research/active/*
/research/active/**/__pycache__/
/research/active/**/*.py[cod]
/research_html