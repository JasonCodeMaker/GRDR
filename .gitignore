/figures/
/graphify-out/
/index/
/logs/
/output
/var
/wandb/
/outputs

# Generated candidates
/candidates/baseline/
/candidates/baselines/
/candidates/GRDR/*/
/candidates/*_ann_*_candidates_t*.json
/candidates/panda_c*_candidates_t*.json

scripts/panda

# Research packages are opt-in so abandoned directions stay local.
/research/*
/research/active/*
